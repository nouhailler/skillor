DATABASE_URL=postgresql+psycopg://skillor:skillor@postgres:5432/skillor
APP_ENV=development
APP_CORS_ORIGINS=http://localhost:8080,http://localhost:4173,http://127.0.0.1:8080,http://127.0.0.1:4173
AUTO_CREATE_SCHEMA=true
SEED_ON_START=true
RAW_DATA_DIR=/data/raw
ADMIN_API_KEY=change-me

ESCO_BASE_URL=https://ec.europa.eu/esco/api
ESCO_LANGUAGE=fr
ESCO_VERSION=latest

EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data
EUROSTAT_DATASET=une_rt_a

FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_BASE_URL=https://api.francetravail.io/partenaire/marche-travail/v1
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_marche-travailv1
